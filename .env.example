# Required: LLM settings
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# Optional: Search & link intelligence
SEARCH_PROVIDER=
SEARCH_API_KEY=
YOUTUBE_API_KEY=
URLHAUS_AUTH_KEY=
URLSCAN_API_KEY=

# Optional: Classifier service, Database & Uploads
CLASSIFIER_URL=http://localhost:8000
DB_PATH=./data/app.db
UPLOAD_DIR=./uploads

# Optional: Crawler microservice (Node/Playwright)
CRAWLER_URL=http://127.0.0.1:3001
CRAWLER_API_KEY=dev-crawler-key

# Optional: Google OAuth & Authentication (localhost:3000)
PORT=3000
CLIENT_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
JWT_SECRET=your_jwt_secret_min_32_chars_long_placeholder
