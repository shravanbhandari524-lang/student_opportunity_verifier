{
  "name": "student-opportunity-verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:all": "node scripts/dev-all.js",
    "classifier:train": "services/classifier/.venv/bin/python services/classifier/train.py",
    "classifier:dev": "services/classifier/.venv/bin/python -m uvicorn services.classifier.app:app --host 127.0.0.1 --port 8000",
    "crawler:dev": "node services/crawler/src/server.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.mjs",
    "test": "node --test 'tests/**/*.test.js'",
    "score:fixtures": "node scripts/score-fixtures.js",
    "agents:run": "node scripts/run-agents.js",
    "check:run": "node scripts/run-check.js",
    "check:live": "node --env-file=.env.local scripts/run-check.js --live --yes-use-fake-message",
    "api:e2e": "node scripts/api-e2e.js",
    "api:live": "node --env-file=.env.local scripts/api-live.js",
    "eval": "node scripts/evaluate.js",
    "eval:fixtures": "node scripts/evaluate.js --fixtures",
    "eval:replay": "node scripts/evaluate.js --replay",
    "privacy:check": "node scripts/privacy-check.js",
    "secrets:scan": "node scripts/secrets-scan.js",
    "demo": "node scripts/demo.js"
  },
  "dependencies": {
    "arctic": "^3.7.0",
    "better-sqlite3": "^11.8.1",
    "cheerio": "^1.2.0",
    "file-type": "^22.2.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.14",
    "libphonenumber-js": "^1.13.15",
    "next": "^15.1.7",
    "pino": "^10.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.7",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19"
  }
}
