# LLM Provider implementation (e.g. gemini, mock)
LLM_PROVIDER=gemini

# Secret API key for the LLM provider (leave empty, never commit)
LLM_API_KEY=

# LLM model identifier for extraction and agent prompts
LLM_MODEL=gemini-2.5-flash

# Web search provider implementation (e.g. google, serpapi, mock)
SEARCH_PROVIDER=google

# Secret API key for web search provider (leave empty, never commit)
SEARCH_API_KEY=

# Secret API key for YouTube Data API v3 comment lookups (leave empty, never commit)
YOUTUBE_API_KEY=

# Secret Auth key for URLhaus threat intelligence API (leave empty, never commit)
URLHAUS_AUTH_KEY=

# Secret API key for urlscan.io automated web scanner (leave empty, never commit)
URLSCAN_API_KEY=

# HTTP endpoint URL for the local Python ML classifier service
CLASSIFIER_URL=http://localhost:8000

# SQLite database file path on disk
DB_PATH=./data/app.db

# Temporary directory for image uploads before extraction cleanup
UPLOAD_DIR=./uploads

# Whether to trust upstream reverse proxy headers for client IP resolution
TRUST_PROXY=false

# Number of reverse proxy hops to traverse from the right when TRUST_PROXY is true
TRUSTED_PROXY_HOPS=1

# Maximum number of concurrent check creation requests permitted
MAX_CONCURRENT_CREATES=2

# Rate limiting sliding time window in milliseconds (default 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum check submissions permitted per rate limit window
RATE_LIMIT_CREATE_MAX=10

# Maximum check confirmations permitted per rate limit window
RATE_LIMIT_CONFIRM_MAX=10

# Maximum read requests (check and report retrieval) permitted per rate limit window
RATE_LIMIT_READ_MAX=60

# Maximum concurrent or repeated stream requests permitted per rate limit window
RATE_LIMIT_STREAM_MAX=10

# Maximum secondary action requests (email, fraud summary, feedback) permitted per rate limit window
RATE_LIMIT_ACTION_MAX=15

# Maximum guide browsing requests permitted per rate limit window
RATE_LIMIT_GUIDE_MAX=60

# Maximum simultaneous active coordinator background investigations
MAX_CONCURRENT_INVESTIGATIONS=4

# Hard daily limit on total check investigations allowed across all clients
GLOBAL_DAILY_CHECK_CAP=500

# External service recording and replaying mode (off, record, replay)
RECORD_REPLAY_MODE=off

# Directory path storing captured network and tool fixture recordings
RECORD_REPLAY_DIR=.recordings
